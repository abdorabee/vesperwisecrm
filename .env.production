# Non-secret defaults for /book-demo and /contact.
# RESEND_API_KEY stays in Vercel (secret). Unverified Resend accounts can send
# from onboarding@resend.dev to the Resend account owner's email only.
# DEMO_INBOX_EMAIL is required and must be set in the host environment.
RESEND_FROM_EMAIL=onboarding@resend.dev
