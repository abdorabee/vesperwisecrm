NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase project settings > API). Server-only.
# Used by scheduled jobs and other trusted server paths. Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the cron scheduler must send as `Authorization: Bearer <value>`.
CRON_SECRET=

# Polar billing — keep disabled until the sandbox products and webhook endpoint
# are configured. Never commit the access token or webhook secret. Billing
# enables automatically once the provider values below are present; set
# POLAR_BILLING_ENABLED=false for an explicit temporary pause.
# Register Polar webhooks at the final HTTPS host. Polar does not follow
# redirects, so use https://www.vesperwisecrm.com/api/webhooks/polar (not the
# apex domain, which 308s to www).
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_TEAM_PRODUCT_ID=
# Optional while Scale checkout remains disabled.
POLAR_SCALE_PRODUCT_ID=
POLAR_ENVIRONMENT=sandbox
POLAR_SCALE_CHECKOUT_ENABLED=false
# Public /pricing checkout link. When unset, the page links to /signup.
NEXT_PUBLIC_POLAR_FOUNDING_CHECKOUT_URL=
# Checkout sends seats only when the Polar product price is seat-based.
# Fixed-price Starter/Team products still check out; paid-seat updates then
# require a seat-based Polar price.

# Resend — https://resend.com
# Required to deliver /book-demo and /contact. Set DEMO_INBOX_EMAIL in the
# host environment. There is no default inbox.
RESEND_API_KEY=
# Optional override for auth, signup, and contact-form mail.
RESEND_FROM_EMAIL=
DEMO_INBOX_EMAIL=

# Resend delivery webhooks (bounce, complaint, failure) for /api/webhooks/resend-events
RESEND_WEBHOOK_SECRET=

# Comma-separated emails allowed to access /platform/email (internal ops)
PLATFORM_ADMIN_EMAILS=

# Optional: POST JSON alerts when email webhooks fail processing
ALERT_WEBHOOK_URL=

# Public site URL
NEXT_PUBLIC_SITE_URL=

# Anthropic — https://console.anthropic.com (AI paste-to-parse on call notes)
ANTHROPIC_API_KEY=

# Google OAuth client — https://console.cloud.google.com (Docs + Drive scopes,
# for one-click property report generation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 raw bytes, base64-encoded (openssl rand -base64 32). Encrypts stored
# Google OAuth tokens. Same packing as the previous server key.
GOOGLE_TOKEN_ENCRYPTION_KEY=
