NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase project settings > API) — only used by the
# /api/cron/process-automation route, never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the cron scheduler must send as `Authorization: Bearer <value>`.
CRON_SECRET=

# Polar billing — keep disabled until the sandbox products and webhook endpoint
# are configured. Never commit the access token or webhook secret. Billing
# enables automatically once the provider values below are present; set
# POLAR_BILLING_ENABLED=false for an explicit temporary pause.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_STARTER_PRODUCT_ID=
POLAR_TEAM_PRODUCT_ID=
# Optional while Scale checkout remains disabled.
POLAR_SCALE_PRODUCT_ID=
POLAR_ENVIRONMENT=sandbox
POLAR_SCALE_CHECKOUT_ENABLED=false

# Resend — https://resend.com
# Required to deliver /book-demo and /contact. From and inbox have production
# defaults in .env.production (onboarding@resend.dev → abdorabee1134@gmail.com).
RESEND_API_KEY=
# Optional override. Tenant CRM mail uses Settings → Email.
RESEND_FROM_EMAIL=
DEMO_INBOX_EMAIL=

# Inbound reply capture — configure inbound subdomain MX in Resend, then subscribe
# email.received webhooks to /api/webhooks/resend-inbound
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=
REPLY_TOKEN_TTL_DAYS=365

# HMAC secret for marketing unsubscribe links (sequences)
UNSUBSCRIBE_SECRET=

# Comma-separated emails allowed to access /platform/email (internal ops)
PLATFORM_ADMIN_EMAILS=

# Optional: POST JSON alerts when email webhooks fail processing
ALERT_WEBHOOK_URL=

# Public site URL for unsubscribe links (production)
NEXT_PUBLIC_SITE_URL=

# Anthropic — https://console.anthropic.com (AI paste-to-parse on call notes)
ANTHROPIC_API_KEY=

# Google OAuth client — https://console.cloud.google.com (Docs + Drive scopes,
# for one-click property report generation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser voice dialer. Bring-your-own-Twilio: each account connects its own
# Twilio account from Dialer -> Settings, so there are no global TWILIO_*
# credentials here for the dialer. Keep disabled until the migrations are
# applied and DIALER_CREDENTIALS_ENCRYPTION_KEY is set.
DIALER_ENABLED=false
DIALER_PROVIDER=twilio
DIALER_PUBLIC_BASE_URL=https://crm.example.com
DIALER_DEFAULT_COUNTRY=US
DIALER_MAX_CALLS_PER_SECOND=1
# 32 raw bytes, base64-encoded (openssl rand -base64 32). Decrypts every
# connected tenant's stored Twilio Auth Token/API Key Secret -- store it at
# the same sensitivity tier as SUPABASE_SERVICE_ROLE_KEY, never commit it,
# and losing it means every connected tenant has to reconnect.
DIALER_CREDENTIALS_ENCRYPTION_KEY=

# Twilio (server-only), used by the separate outbound/inbound SMS feature --
# not read by the dialer.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
